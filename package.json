{
  "name": "claude-propagate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Declare, watch and record the couplings between files that must move together \u2014 across branches, worktrees and repos. Append-only ledger; never edits a downstream. See SKILL.md.",
  "main": "watcher.mjs",
  "bin": {
    "propagate": "cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "watcher": "node watcher.mjs",
    "smoke": "node watcher.mjs --smoke",
    "test": "PROPAGATE_STATE_DIR=\"${TMPDIR:-/tmp}/propagate-test-state\" node --test 'tests/*.test.mjs'",
    "setup": "node cli.mjs setup"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.6.0"
  }
}
