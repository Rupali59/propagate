<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tathya.propagate.watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/Cellar/node/25.9.0_1/bin/node</string>
    <string>/Users/rupali.b/.claude/skills/propagate/watcher.mjs</string>
  </array>

  <!-- Fire on any change in these directories. launchd coalesces rapid
       events; the watcher's lock makes concurrent invocations safe.
       Generated by lib/plist.mjs from discovered workspaces. -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/rupali.b/Documents/GitHub</string>
    <string>/Users/rupali.b/Documents/GitHub/Keerti/Keerti-portfolio</string>
    <string>/Users/rupali.b/Documents/GitHub/Keerti/Keerti-portfolio/docs</string>
    <string>/Users/rupali.b/Documents/GitHub/ManavDaehi</string>
    <string>/Users/rupali.b/Documents/GitHub/ManavDaehi/Manav-portfolio</string>
    <string>/Users/rupali.b/Documents/GitHub/ManavDaehi/Manav-portfolio/docs</string>
    <string>/Users/rupali.b/Documents/GitHub/ManavDaehi/docs</string>
    <string>/Users/rupali.b/Documents/GitHub/PanditPawanKaushik</string>
    <string>/Users/rupali.b/Documents/GitHub/PanditPawanKaushik/SSJK-mb</string>
    <string>/Users/rupali.b/Documents/GitHub/PanditPawanKaushik/SSJK-mb/docs</string>
    <string>/Users/rupali.b/Documents/GitHub/PanditPawanKaushik/docs</string>
    <string>/Users/rupali.b/Documents/GitHub/Vipin Kaushik</string>
    <string>/Users/rupali.b/Documents/GitHub/Vipin Kaushik/docs</string>
  </array>

  <!-- Don't restart on exit; we run once per file event. -->
  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>

  <!-- Throttle: launchd won't fire more than once per N seconds even if
       multiple file events arrive. Coalesces editor bursts. -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- Periodic poll. WatchPaths only fires for direct-child changes of
       listed dirs; deeply-nested edits (e.g. lib/pricing.ts under a
       project root) don't always trigger. StartInterval guarantees a
       full scan every N seconds regardless. Replaces the accidental
       feedback-loop polling that arose from unconditional ledger MD
       re-render. -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/rupali.b/.claude/skills/propagate/watcher.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/rupali.b/.claude/skills/propagate/watcher.stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
