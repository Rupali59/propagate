<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rupali.propagate-digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/rupali.b/.claude/skills/propagate/digest.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/rupali.b</string>
  </dict>

  <!-- Once a day at 09:00. Not tied to file-save events like the watcher's
       plist — this is a scheduled digest, not a reactive one. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Do not fire immediately on load — only at the scheduled time. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- One-shot per interval; do not restart on exit. -->
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/propagate-digest.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/propagate-digest.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
